# Telegram: токен от @BotFather. Privacy mode выключить (/setprivacy -> Disable) и передобавить бота в группу.
TG_BOT_TOKEN=
# Публичный адрес сайта (cloudflared tunnel --url http://localhost:8000). https нужен для кнопки «Показать на канвасе».
PUBLIC_BASE_URL=http://localhost:8000
PORT=8000

# LLM: любой OpenAI-совместимый endpoint. OpenRouter: https://openrouter.ai/api/v1
# Anthropic напрямую: https://api.anthropic.com/v1/
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
FAST_MODEL=anthropic/claude-haiku-5.5
STRONG_MODEL=anthropic/claude-sonnet-5.5
FALLBACK_MODEL=
# auto | json_schema | prompt — как просить JSON (auto сам переключится, если провайдер не умеет json_schema)
LLM_JSON_MODE=auto
# off | record | replay — на репетиции record, на защите replay
CACHE_MODE=off

DEBOUNCE_S=1.5
BOT_COOLDOWN_S=60
# «Маркетолог: текст» -> автор «Маркетолог». Выключи (0) в настоящем рабочем чате.
ROLEPLAY_NAMES=1
